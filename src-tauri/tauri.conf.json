{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkDB",
  "version": "0.1.0",
  "identifier": "com.thanadon.markdb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkDB",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#16161e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NDExNkY3NEVBRUY3MUEKUldRYTk2NU85eFpCcGJBMkxVY0FBRUZsUHpxRDVkWE9GOWZnTXRPZzR1N3dSL1UvYVlxVEE0UFIK",
      "endpoints": [
        "https://github.com/thanadon-dev/markdb/releases/latest/download/latest.json"
      ]
    }
  }
}
